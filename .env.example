# Copia este archivo a .env.local y completa los valores.
# Cada variable nueva se declara también en src/shared/lib/env.ts (validación con zod).

# URL base de calidoc-api, sin barra final. Requerida: el build falla si falta o no es una URL válida.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Llave PUBLICA de Culqi (pk_test_...). Segura para el navegador: solo puede crear tokens.
# NUNCA pongas aqui la llave privada (sk_...): esa vive solo en calidoc-api.
NEXT_PUBLIC_CULQI_PUBLIC_KEY=

# Client ID de Google (OAuth, tipo Web). Público. Si está vacío, se oculta el acceso con Google.
# Orígenes JavaScript autorizados en Google Cloud: http://localhost:3000 y el dominio de producción.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Secreto de cliente de Google (solo servidor, NUNCA NEXT_PUBLIC_): canjea el código por el ID token.
GOOGLE_CLIENT_SECRET=

# Secreto del servidor para cifrar la cookie del registro pendiente (min. 32 caracteres).
# Genéralo con: openssl rand -base64 32
# Variables privadas: se validan en src/shared/lib/env.server.ts (nunca NEXT_PUBLIC_).
AUTH_SECRET=

# Solo desarrollo local: Node no confía en el certificado autofirmado de la API en https://localhost.
# Descomenta en .env.local si el servidor de Next no logra llamar a la API (error DEPTH_ZERO_SELF_SIGNED_CERT).
# NODE_TLS_REJECT_UNAUTHORIZED=0

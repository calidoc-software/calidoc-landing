# Copia este archivo a .env.local y completa los valores.
# Cada variable nueva se declara también en src/shared/lib/env.ts (validación con zod).

# URL base de calidoc-api, sin barra final. Requerida: el build falla si falta o no es una URL válida.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Llave PUBLICA de Culqi (pk_test_...). Segura para el navegador: solo puede crear tokens.
# NUNCA pongas aqui la llave privada (sk_...): esa vive solo en calidoc-api.
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
